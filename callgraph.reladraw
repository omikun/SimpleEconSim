// ============================================================================
// Call of Capital: Modern Economic Warfare / SimpleEconSim — Complete Module & Class Call Graph (reladraw v0.7.1)
// Stated relative positions and hierarchical domain clusters.
// ============================================================================

// --- Styles ---
style server         fill: #0f172a  border: #38bdf8  line: #38bdf8
style ui             fill: #1e1b4b  border: #818cf8  line: #818cf8
style render         fill: #311042  border: #c084fc  line: #c084fc
style orchestration  fill: #064e3b  border: #34d399  line: #34d399
style spatial        fill: #14532d  border: #4ade80  line: #4ade80
style macro          fill: #701a75  border: #f472b6  line: #f472b6
style meso           fill: #78350f  border: #fbbf24  line: #fbbf24
style micro          fill: #451a03  border: #f97316  line: #f97316
style agent          fill: #4c0519  border: #fb7185  line: #fb7185
style utils          fill: #262626  border: #a3a3a3  line: #a3a3a3
style dim            text: (color: muted)

// --- Subsystem Containers ---
node server_net "Authoritative Server & Network Protocol"  style: server
node desktop_ui "Desktop Presentation UI (Pygame)"  right of server_net  gap: wide  style: ui
node render_engine "3D & GPU Render Engine (ModernGL)"  right of desktop_ui  gap: wide  style: render

node orchestration "Simulation Orchestration & Lifecycle"  below server_net  gap: wide  style: orchestration
node spatial_mesh "Spatial Mesh & Procedural Geography"  left of orchestration  gap: wide  style: spatial
node macro_sovereign "Macroeconomic & Sovereign Systems"  below orchestration  gap: wide  style: macro
node meso_institutions "Mesoeconomic Institutions & Markets"  right of macro_sovereign  gap: wide  style: meso
node micro_regional "Regional Tile Economy & Commodity Auctions"  below macro_sovereign  gap: wide  style: micro
node agent_layer "Micro-Agents, Class & Metabolic Rift"  below micro_regional  gap: wide  style: agent
node support_utils "Diagnostics, Analytics & Tooling"  right of meso_institutions  gap: wide  style: utils

