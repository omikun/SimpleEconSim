// --- Architecture & Turn Pipeline Callgraph Edges ---
edge server_net.sim_server_sim_server -> orchestration.sim_engine "executes turn pipeline / step_turn(t)"  from: bottom  to: top
edge server_net.sim_server_sim_server -> orchestration.sim_world "build_world(seed)"  from: bottom  to: top
edge server_net.sim_server_web_server -> server_net.sim_server_sim_server "dispatches client commands"  from: left  to: right
edge server_net.sim_server_protocol -> server_net.sim_server_sim_server "typed CommandMessage / ServerEvent"  from: left  to: right
edge server_net.game_client_game_client -> server_net.sim_server_web_server "REST / WebSocket stream"  from: bottom  to: top
edge desktop_ui.worldview -> desktop_ui.worldview_engine "drives game loop / step_world()"  from: bottom  to: top
edge desktop_ui.worldview_engine -> orchestration.sim_engine "step_turn() tick"  from: left  to: right
edge desktop_ui.worldview -> render_engine.render_engine_core "render_frame()"  from: right  to: left
edge desktop_ui.worldview_gov_panel -> macro_sovereign.nation "enact decrees / adjust taxes"  from: bottom  to: top
edge desktop_ui.worldview_debt_panel -> macro_sovereign.sovereign_bonds "float sovereign bonds"  from: bottom  to: top
edge desktop_ui.worldview_diplomacy_panel -> macro_sovereign.diplomacy "propose treaties / embargoes"  from: bottom  to: top
edge desktop_ui.worldview_military_panel -> macro_sovereign.army "mobilize standing army"  from: bottom  to: top
edge desktop_ui.worldview_science_panel -> macro_sovereign.innovation "sponsor royal patent prizes"  from: bottom  to: top
edge desktop_ui.worldview_build_panel -> macro_sovereign.intents "queue municipal / state infrastructure"  from: bottom  to: top
edge desktop_ui.worldview_cadastre -> agent_layer.land_tenure "inspect tenure / enforce enclosure"  from: bottom  to: top
edge desktop_ui.worldview_citizens -> agent_layer.social_class "inspect agent lineages & class breakdown"  from: bottom  to: top
edge desktop_ui.worldview_charts -> micro_regional.region "query GDP / prices / surplus value"  from: bottom  to: top
edge render_engine.render_engine_core -> render_engine.render_engine_terrain "draw_terrain()"  from: bottom  to: top
edge render_engine.render_engine_core -> render_engine.render_engine_hex_renderer "draw_hexes()"  from: bottom  to: top
edge render_engine.render_engine_terrain -> render_engine.render_engine_gpu_mesh_brdf_pipeline "render_mesh_brdf()"  from: bottom  to: top
edge render_engine.render_engine_terrain -> spatial_mesh.polygon_map "sample dual-mesh corners / elevations"  from: left  to: right
edge render_engine.render_engine_hex_renderer -> spatial_mesh.hexmap "sample axial coordinates"  from: left  to: right
edge orchestration.sim_world -> spatial_mesh.polygon_map "build_world_voronoi() / dual mesh"  from: left  to: right
edge orchestration.sim_world -> spatial_mesh.hexmap "build_world_hex() / honeycomb layout"  from: left  to: right
edge orchestration.sim_world -> orchestration.tile_resources "assign_tile_resources()"  from: bottom  to: top
edge orchestration.sim_world -> orchestration.world_names "assign_world_identities()"  from: bottom  to: top
edge orchestration.sim_world -> meso_institutions.province "partition_contiguous() / build provinces"  from: bottom  to: top
edge orchestration.sim_world -> macro_sovereign.nation "instantiate Sovereign Nations"  from: bottom  to: top
edge orchestration.sim_engine -> macro_sovereign.ai_nation "0a. decide_turn() / sovereign AI"  from: bottom  to: top
edge orchestration.sim_engine -> macro_sovereign.intents "0b. step_intents_and_construction()"  from: bottom  to: top
edge macro_sovereign.intents -> macro_sovereign.buildings "advance navvy construction projects"  from: bottom  to: top
edge orchestration.sim_engine -> meso_institutions.world_trade "1. pending_imports()"  from: right  to: left
edge orchestration.sim_engine -> meso_institutions.province "2a. Province.step() shared institutions"  from: bottom  to: top
edge orchestration.sim_engine -> micro_regional.region "2b. Region.step_economy() tile simulation"  from: bottom  to: top
edge orchestration.sim_engine -> meso_institutions.transporter "3. advance() & deliver cargo"  from: right  to: left
edge orchestration.sim_engine -> agent_layer.disease "3b. step_trade_epidemic_transmission()"  from: bottom  to: top
edge orchestration.sim_engine -> meso_institutions.trade_settle "5. settle_trade() bilateral clearing"  from: right  to: left
edge orchestration.sim_engine -> meso_institutions.forex "6. cycle_all_markets() / convert wallets"  from: right  to: left
edge orchestration.sim_engine -> meso_institutions.migration "7. run_migrations() displaced flight"  from: right  to: left
edge orchestration.sim_engine -> meso_institutions.claims "8. check_and_apply_claims()"  from: right  to: left
edge orchestration.sim_engine -> macro_sovereign.regime "10. step_regime() / coups & elections"  from: bottom  to: top
edge orchestration.sim_engine -> macro_sovereign.army "10b. step_armies() military upkeep"  from: bottom  to: top
edge orchestration.sim_engine -> macro_sovereign.diplomacy "10c. update_relations() diplomatic drift"  from: bottom  to: top
edge orchestration.sim_engine -> macro_sovereign.innovation "10d. step_innovation() tech diffusion"  from: bottom  to: top
edge orchestration.sim_engine -> agent_layer.popular_resistance "10e. step_popular_resistance() revolts"  from: bottom  to: top
edge orchestration.sim_engine -> macro_sovereign.imperialism "10f. step_imperialism() debt enforcement"  from: bottom  to: top
edge orchestration.sim_engine -> meso_institutions.ledger "12. audit_currency_total() vs ledger.cleared()"  from: right  to: left
edge micro_regional.region -> agent_layer.secular_climate "get_secular_climate(t)"  from: bottom  to: top
edge micro_regional.region -> agent_layer.foraging "forage_tile() customary usufruct"  from: bottom  to: top
edge micro_regional.region -> micro_regional.region_labor "run_labour() wage & shift contracts"  from: bottom  to: top
edge micro_regional.region -> agent_layer.labor_resistance "step_workplace_resistance() strikes"  from: bottom  to: top
edge micro_regional.region -> micro_regional.region_production "produce() commodity manufacturing"  from: bottom  to: top
edge micro_regional.region -> agent_layer.feudal_tribute "collect_tribute() in-kind seigneurial dues"  from: bottom  to: top
edge micro_regional.region -> micro_regional.region_market "trade() double-auction clearance"  from: bottom  to: top
edge micro_regional.region -> micro_regional.region_finance "pay_wages() & redeem scrip"  from: bottom  to: top
edge micro_regional.region -> agent_layer.land_rent "collect_rents() on enclosed plots"  from: bottom  to: top
edge micro_regional.region -> agent_layer.enclosure "step_enclosure_survey_debts()"  from: bottom  to: top
edge micro_regional.region -> agent_layer.labor_contract "aggregate_tile_surplus() exploitation rate"  from: bottom  to: top
edge micro_regional.region -> agent_layer.demographics_consumption "consume() food calories & cost-of-living"  from: bottom  to: top
edge micro_regional.region -> agent_layer.demographics_reproduction "reproduce() & mortality"  from: bottom  to: top
edge micro_regional.region -> agent_layer.social_class "update_tile_social_classes()"  from: bottom  to: top
edge micro_regional.region -> meso_institutions.workhouse "step_workhouse() penal labor"  from: right  to: left
edge micro_regional.region -> agent_layer.alienation "step_tile_alienation() worker despair"  from: bottom  to: top
edge micro_regional.region -> agent_layer.externalities "step_tile_externalities() metabolic rift"  from: bottom  to: top
edge micro_regional.region -> agent_layer.disease "step_tile_diseases() epidemics & clinics"  from: bottom  to: top
edge micro_regional.region -> agent_layer.unrest "step_unrest() threat escalation"  from: bottom  to: top
edge micro_regional.region -> agent_layer.agent "manages instances of Agent class"  from: bottom  to: top
edge macro_sovereign.nation -> macro_sovereign.sovereign_bonds "issues sovereign debt / floats bonds"  from: right  to: left
edge macro_sovereign.sovereign_bonds -> meso_institutions.ledger "records bond defaults / debt cancellations"  from: bottom  to: top
edge meso_institutions.forex -> meso_institutions.banking_policy "clears interbank forex balances"  from: bottom  to: top
edge meso_institutions.claims -> spatial_mesh.wilderness "encloses frontier wilderness plots"  from: left  to: right
edge spatial_mesh.polygon_map -> spatial_mesh.hydraulic_erosion "simulates fluvial erosion & river carving"  from: bottom  to: top
edge spatial_mesh.polygon_map -> spatial_mesh.heightmap "generates tectonic elevation profiles"  from: bottom  to: top
edge spatial_mesh.polygon_map -> spatial_mesh.terrain_edges "traces cliffs & coastlines"  from: bottom  to: top
edge support_utils.wealth_collector -> agent_layer.agent "audits agent wealth distribution"  from: left  to: right
edge support_utils.wealth_lineage -> agent_layer.agent "traces dynastic family fortunes"  from: left  to: right
